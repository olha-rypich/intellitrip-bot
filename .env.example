# Copy this file to ".env" and replace placeholders with your values.
# Never commit ".env" or real tokens.

# Telegram Bot API — from @BotFather (format: 123456789:ABCdef...)
TELEGRAM_BOT_TOKEN=<YOUR_TELEGRAM_BOT_TOKEN>

# Google Cloud — API key with Places API (New) enabled and billing active
GOOGLE_PLACES_API_KEY=<YOUR_GOOGLE_PLACES_API_KEY>

# TimeZoneDB — https://timezonedb.com/api
TIMEZONEDB_API_KEY=<YOUR_TIMEZONEDB_API_KEY>

# Nominatim requires an identifying User-Agent (app name + contact URL or email)
NOMINATIM_USER_AGENT=IntelliTripBot/1.0 (contact: your-email@example.com)

# Wikimedia recommends a descriptive User-Agent for API requests
WIKIPEDIA_USER_AGENT=IntelliTripBot/1.0 (contact: your-email@example.com)

# Optional — Wikipedia language code (default: en)
# WIKIPEDIA_LANG=en

# Optional — nearby search radius in meters (default: 1500)
# PLACES_SEARCH_RADIUS_METERS=1500

# Optional — max nearby results, 1–20 (default: 8)
# NEARBY_MAX_RESULTS=8

# Optional — logging: DEBUG, INFO, WARNING, ERROR (default: INFO)
# LOG_LEVEL=INFO
